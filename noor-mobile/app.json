{
  "expo": {
    "name": "Noor-e-ilahi: Daily Islamic App",
    "slug": "noor-islamic-app",
    "version": "1.0.0",
    "description": "Precision astronomical prayer times, Noble Quran audio recitation, Wudu & Salah guides, Zakat calculator, Hajj & Umrah checklist, Janazah guide, authentic Hisn al-Muslim duas, 3D Qibla compass, and audited global Ziyarat shrines.",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "primaryColor": "#059669",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#031712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noor.app",
      "associatedDomains": [
        "applinks:www.nooreilahi.com",
        "applinks:nooreilahi.com",
        "applinks:noor.app"
      ]
    },
    "android": {
      "package": "com.noor_e_ilahi",
      "googleServicesFile": "./google-services.json",
      "versionCode": 5,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#031712"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.nooreilahi.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "nooreilahi.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "noor.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Noor-e-ilahi to access your location to calculate accurate local prayer times and Qibla direction."
        }
      ]
    ],
    "scheme": "noor",
    "extra": {
      "gaMeasurementId": "G-6VEVYV7DX2",
      "router": {},
      "eas": {
        "projectId": "e0a57603-71f2-4b1d-9464-470aa48e6b69"
      }
    },
    "owner": "nooreilahi"
  }
}
