{
  "expo": {
    "name": "NOOR",
    "slug": "noor-islamic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#031712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031712"
      },
      "package": "com.noor.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "noor"
  }
}
